    "dry-run": "tsx src/bench.ts --dry-run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1053.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "license": "UNLICENSED"
}
