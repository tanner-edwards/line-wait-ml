{
  "name": "club32-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Repeatable evaluation harness for the /v2/recommendations LLM prompt (speed, rule checks, automated head-to-head judging). Not part of the app.",
  "scripts": {
    "bench": "tsx src/bench.ts",
    "compare": "tsx src/compare.ts",
