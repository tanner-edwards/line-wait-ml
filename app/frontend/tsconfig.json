{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Overrides (doesn't merge with) the base exclude — base entries repeated.
  // dist/ holds the minified web bundle from deploy-web.sh; with allowJs on,
  // type-checking it overflows tsc's stack.
  "exclude": ["node_modules", "dist", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios"]
}
